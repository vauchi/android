<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vauchi" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen shown during process init (before Compose renders).
         Uses the SplashScreen compat library for consistent behavior on API 23+. -->
    <style name="Theme.Vauchi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Vauchi</item>
    </style>
</resources>
